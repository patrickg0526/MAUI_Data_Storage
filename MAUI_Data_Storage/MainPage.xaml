<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUI_Data_Storage.Models"
             x:Class="MAUI_Data_Storage.MainPage">

    <Grid RowDefinitions="Auto,*" Padding="30,0">
        <VerticalStackLayout Grid.Row="0" Spacing="12">
            <Label
                Text="Patrick Gonzalez - Inventory Tracker"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />
            <Label
                Text="Please provide the following information:"
                FontSize="18"
                HorizontalOptions="Center" />

            <Grid
                RowDefinitions="Auto,Auto,Auto"
                ColumnDefinitions="Auto,*"
                RowSpacing="10"
                ColumnSpacing="15">
                <Label Grid.Row="0" Grid.Column="0" Text="Item ID" VerticalTextAlignment="Center" />
                <Entry Grid.Row="0" Grid.Column="1" x:Name="txtItemId" Placeholder="e.g. A-100" />
                <Label Grid.Row="1" Grid.Column="0" Text="Item Name" VerticalTextAlignment="Center" />
                <Entry Grid.Row="1" Grid.Column="1" x:Name="txtItemName" Placeholder="Enter the item name" />
                <Label Grid.Row="2" Grid.Column="0" Text="Item Description" VerticalTextAlignment="Center" />
                <Entry Grid.Row="2" Grid.Column="1" x:Name="txtItemDescription" Placeholder="Enter a short description" />
            </Grid>

            <Button
                x:Name="btnSave"
                Text="Save"
                HorizontalOptions="Center"
                WidthRequest="160"
                Clicked="OnSaveClicked" />

            <Label
                x:Name="lblMessage"
                HorizontalOptions="Center"
                IsVisible="False" />

            <Label Text="Stored Items" FontSize="20" FontAttributes="Bold" Margin="0,10,0,0" />
            <Grid ColumnDefinitions="100,200,*" Padding="10,0">
                <Label Grid.Column="0" Text="Item ID" FontAttributes="Bold" />
                <Label Grid.Column="1" Text="Item Name" FontAttributes="Bold" />
                <Label Grid.Column="2" Text="Item Description" FontAttributes="Bold" />
            </Grid>
            <BoxView HeightRequest="1" Color="{StaticResource Gray400}" />
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Items}"
            SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No items have been saved yet." Margin="10,10" TextColor="{StaticResource Gray400}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Item">
                    <Grid ColumnDefinitions="100,200,*" Padding="10,8">
                        <Label Grid.Column="0" Text="{Binding ItemId}" />
                        <Label Grid.Column="1" Text="{Binding ItemName}" />
                        <Label Grid.Column="2" Text="{Binding ItemDescription}" LineBreakMode="WordWrap" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
